CREATE TABLE PRODUCTO (ID INTEGER NOT NULL, ACTIVO TINYINT(1) default 0, NOMBRE VARCHAR(255), PRECIO DOUBLE, REF INTEGER, STOCK INTEGER, VERSION INTEGER, MARCA_ID INTEGER, PRIMARY KEY (ID))
CREATE TABLE VENTA (ID INTEGER NOT NULL, FECHA VARCHAR(255), PRECIO DOUBLE, VERSION INTEGER, EMPLEADO_ID INTEGER, PRIMARY KEY (ID))
CREATE TABLE LINEAVENTA (CANTIDAD INTEGER, PRECIO DOUBLE, VERSION INTEGER, VENTA INTEGER NOT NULL, PRODUCTO INTEGER NOT NULL, UUID LONGBLOB NOT NULL, PRODUCTO_ID INTEGER, VENTA_ID INTEGER, PRIMARY KEY (VENTA, PRODUCTO, UUID))
CREATE TABLE DEPARTAMENTO (ID INTEGER NOT NULL, ACTIVO TINYINT(1) default 0, NOMBRE VARCHAR(255), SALA INTEGER, SUELDOHORA DOUBLE, VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE EMPLEADO (ID INTEGER NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, HORASMENSUALES INTEGER, TAG INTEGER, VERSION INTEGER, DEPARTAMENTO_ID INTEGER, DESPACHO INTEGER, HORASEXTRA INTEGER, NOCHES TINYINT(1) default 0, SECCION INTEGER, PRIMARY KEY (ID))
CREATE TABLE MARCA (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, NOMBRE VARCHAR(255) NOT NULL UNIQUE, ORIGEN VARCHAR(255), VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE PROVEEDOR (ID INTEGER NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, NOMBRE VARCHAR(255), VERSION INTEGER, IMPUESTO DOUBLE, PAIS VARCHAR(255), CODIGOPOSTAL INTEGER, PRIMARY KEY (ID))
CREATE TABLE PRODUCTO_PROVEEDOR (productos_ID INTEGER NOT NULL, proveedores_ID INTEGER NOT NULL, PRIMARY KEY (productos_ID, proveedores_ID))
ALTER TABLE PRODUCTO ADD CONSTRAINT FK_PRODUCTO_MARCA_ID FOREIGN KEY (MARCA_ID) REFERENCES MARCA (ID)
ALTER TABLE VENTA ADD CONSTRAINT FK_VENTA_EMPLEADO_ID FOREIGN KEY (EMPLEADO_ID) REFERENCES EMPLEADO (ID)
ALTER TABLE LINEAVENTA ADD CONSTRAINT FK_LINEAVENTA_PRODUCTO_ID FOREIGN KEY (PRODUCTO_ID) REFERENCES PRODUCTO (ID)
ALTER TABLE LINEAVENTA ADD CONSTRAINT FK_LINEAVENTA_VENTA_ID FOREIGN KEY (VENTA_ID) REFERENCES VENTA (ID)
ALTER TABLE EMPLEADO ADD CONSTRAINT FK_EMPLEADO_DEPARTAMENTO_ID FOREIGN KEY (DEPARTAMENTO_ID) REFERENCES DEPARTAMENTO (ID)
ALTER TABLE PRODUCTO_PROVEEDOR ADD CONSTRAINT FK_PRODUCTO_PROVEEDOR_productos_ID FOREIGN KEY (productos_ID) REFERENCES PRODUCTO (ID)
ALTER TABLE PRODUCTO_PROVEEDOR ADD CONSTRAINT FK_PRODUCTO_PROVEEDOR_proveedores_ID FOREIGN KEY (proveedores_ID) REFERENCES PROVEEDOR (ID)
